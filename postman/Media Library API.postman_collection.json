    {
      "name": "Delete Media - valid (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has success structure with null data', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql('success');",
              "    pm.expect(json.data).to.be.null;",
              "});"
            ]
          }
        }
      ],
      "request": {
