      },
      "response": []
    },
    {
      "name": "Update Media - valid (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Title was updated', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql('success');",
              "    pm.expect(json.data.title).to.eql('Updated Title via Postman');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Title via Postman\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/media/{{MEDIA_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["media", "{{MEDIA_ID}}"]
        }
      },
      "response": []
    },
